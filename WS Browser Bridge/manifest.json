{
  "manifest_version": 3,
  "name": "FB Browser Bridge",
  "version": "1.2",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms" 
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}